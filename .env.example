# Cara termudah & aman:  node scripts/init-env.js   (membuat .env dengan secret dan password acak)
# Manual: salin menjadi .env lalu ganti semua nilai bertanda WAJIB.

# WAJIB: string acak minimal 32 karakter untuk menandatangani token login (API menolak start bila lemah)
# buat dengan: openssl rand -hex 32
JWT_SECRET=ganti-dengan-string-acak-panjang

# WAJIB: password database (hanya berlaku saat database pertama kali dibuat)
DB_PASSWORD=ganti-password-database

# WAJIB: akun admin pertama (dibuat sekali saat database masih kosong; ganti password setelah login)
ADMIN_EMAIL=admin@ttx.local
ADMIN_PASSWORD=ganti-password-admin
ORG_NAME=

# Port aplikasi di host. Saat memakai HTTPS (profil https), set WEB_BIND=127.0.0.1
WEB_PORT=8080
WEB_BIND=0.0.0.0

# HTTPS lewat Caddy: docker compose --profile https up -d
#   DOMAIN : host yang diakses peserta (domain atau IP server)
#   TLS    : internal (CA lokal, jaringan internal) atau email (Let's Encrypt, domain publik)
#   TRUST_PROXY: 1 = tanpa Caddy, 2 = dengan Caddy (agar IP peserta terbaca benar)
DOMAIN=localhost
TLS=internal
TRUST_PROXY=1

# Data demo (pengguna + latihan contoh Pemda). Hanya untuk gladi/pelatihan, false untuk produksi.
SEED_DEMO=false
DEMO_PASSWORD=demo12345

# Mesin AI: builtin (offline) | anthropic | ollama
AI_PROVIDER=builtin
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

UPLOAD_MAX_MB=20

# Peserta boleh membuat akun sendiri (bisa diubah admin di menu Pengaturan)
ALLOW_REGISTRATION=true

# Batas percobaan. Login & token hanya menghitung percobaan GAGAL, sehingga banyak peserta
# di satu Wi-Fi (satu IP) tidak saling memblokir.
# login gagal per akun per IP / 15 menit, dan per IP / 15 menit
LOGIN_RATE_LIMIT=10
LOGIN_IP_RATE_LIMIT=200
# pendaftaran per IP / jam
REGISTER_RATE_LIMIT=200
# token tim salah per akun / 15 menit, dan per IP / 15 menit
JOIN_RATE_LIMIT=20
JOIN_IP_RATE_LIMIT=200

# Pengingat sebelum jadwal latihan (menit)
REMIND_BEFORE_MIN=15

# Chat: maks pesan per orang per 10 detik
CHAT_RATE_LIMIT=20
# Audit log lebih tua dari N hari dihapus otomatis (0 = simpan selamanya)
AUDIT_RETENTION_DAYS=180

# Batas sumber daya & log (sesuaikan dengan kapasitas server)
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
API_MEMORY_LIMIT=512m
API_HEAP_MB=384
DB_MEMORY_LIMIT=1g
PG_SHARED_BUFFERS=256MB

# Backup otomatis ke folder ./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
